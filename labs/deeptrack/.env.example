# deeptrack — copy to .env (git-ignored). Everything has a local default except the Vertex project.

##### MODEL (Vertex AI, as marvin) — gcloud auth application-default login #####
DEEPTRACK_MODEL_PROJECT=
DEEPTRACK_MODEL_LOCATION=global
DEEPTRACK_MODEL_REF=google_genai:gemini-3.8-flash
DEEPTRACK_MODEL_THINKING_LEVEL=medium
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/adc.json   # only if ADC is not in the default location

##### LANGFUSE (stack/watch/langfuse headless defaults) #####
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_FLUSH_INTERVAL=5.0

##### ONTOLOGY SERVERS (compose.yml) #####
DEEPTRACK_ONTO_REF_URL=http://localhost:8080/mcp
DEEPTRACK_ONTO_VAL_URL=http://localhost:8081/mcp
