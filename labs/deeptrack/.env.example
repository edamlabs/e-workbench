# deeptrack — `make env` writes .env (git-ignored) from this file: every `@secret` becomes 32 random bytes in hex.
# One file for compose (LABS_*) and the app (LABS_* + DEEPTRACK_*).

##### PORTS — reserved block 28100–28199 #####
LABS_LANGFUSE_PORT=28100
LABS_ONTOREF_PORT=28101
LABS_ONTOVAL_PORT=28102

##### LANGFUSE — org `labs`, project, environment, keys and admin seeded headless on first boot #####
LABS_LANGFUSE_PROJECT=labs-deeptrack
LABS_LANGFUSE_ENVIRONMENT=labs
LABS_LANGFUSE_PUBLIC_KEY=pk-lf-labs-@secret
LABS_LANGFUSE_SECRET_KEY=sk-lf-labs-@secret
LABS_LANGFUSE_USER_EMAIL=admin@labs.local
LABS_LANGFUSE_USER_PASSWORD=@secret
LABS_LANGFUSE_FLUSH_INTERVAL=5.0

##### LANGFUSE INTERNALS #####
LABS_LANGFUSE_SALT=@secret
LABS_LANGFUSE_NEXTAUTH_SECRET=@secret
LABS_LANGFUSE_ENCRYPTION_KEY=@secret
LABS_PG_PASSWORD=@secret
LABS_CH_PASSWORD=@secret
LABS_REDIS_PASSWORD=@secret
LABS_MINIO_PASSWORD=@secret

##### MODEL — Vertex AI, as marvin: gcloud auth application-default login #####
DEEPTRACK_VERTEX_PROJECT=
DEEPTRACK_VERTEX_LOCATION=global
DEEPTRACK_VERTEX_REF=google_genai:gemini-3.8-flash
DEEPTRACK_VERTEX_THINKING_LEVEL=medium
